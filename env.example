# Токен бота от @BotFather
BOT_TOKEN=

# (опционально) ограничить бота списком user_id через запятую, например: 123456789,987654321
# Оставь пустым, если бот открыт для всех
ALLOWED_USERS=

# Максимальный размер файла в МБ, который бот будет пытаться отправить (ограничение Telegram для ботов — 50MB на обычных серверах API)
MAX_FILE_SIZE_MB=50

# (опционально) путь к файлу cookies.txt (формат Netscape) — нужен, если Instagram
# просит авторизацию на конкретных постах ("sent an empty media response")
COOKIES_FILE=cookies.txt
